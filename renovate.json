{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "internalChecksFilter": "strict",
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "matchDatasources": [
        "go"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "minimumReleaseAge": "3 days",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchDatasources": [
        "go"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "7 days",
      "automerge": false
    }
  ]
}
